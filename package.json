{
	"name": "print-portal",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5180",
		"build": "vite build",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"send-secure": "node --experimental-strip-types scripts/send-secure.ts"
	},
	"dependencies": {
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
