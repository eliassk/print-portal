# Printer address. Raw port 9100 and IPP port 631 MUST be reachable from the host.
PRINTER_HOST=10.134.13.10
PRINTER_PORT=9100
PRINTER_IPP_PORT=631
# MUST match "Delete Time Setting" for secure documents on the printer.
PIN_TTL_MIN=60
MAX_UPLOAD_MB=50
MAX_PHOTOS=36
# adapter-node refuses bodies over 512 KB by default. MUST be above MAX_UPLOAD_MB.
BODY_SIZE_LIMIT=52M
# Uploads, the job log and settings live here.
DATA_DIR=./data
# Address in the QR code on the card next to the printer.
PORTAL_URL=https://drukarka.konfero.pl
# Admin panel at /admin. It stays off until both are set. ADMIN_SECRET MUST be 32+ random characters:
#   openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SECRET=
# LAN address of the Ubuntu VM. docker compose binds the portal to it only.
LAN_IP=
# Port the portal listens on. Use another one when 80 is taken (e.g. by UISP).
PORTAL_PORT=80

# --- HTTPS (optional, see README "HTTPS on a local domain") ---
# Name people open, e.g. drukarka.konfero.pl. Point it to LAN_IP in the router's local DNS only.
PORTAL_DOMAIN=
# Cloudflare API token with Zone → DNS → Edit for this one zone. Used only for the ACME TXT record.
CF_API_TOKEN=
# Let's Encrypt sends expiry warnings here if renewal ever fails.
ACME_EMAIL=
# 443, or another port when 443 is taken (UISP holds it on mediacontrol-vm).
HTTPS_PORT=443
# Empty for 443, otherwise ":<HTTPS_PORT>", e.g. ":8443". Must match HTTPS_PORT.
HTTPS_PORT_SUFFIX=
