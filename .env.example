# Printer address. Raw port 9100 and IPP port 631 MUST be reachable from the host.
PRINTER_HOST=10.134.13.10
PRINTER_PORT=9100
PRINTER_IPP_PORT=631
# MUST match "Delete Time Setting" for secure documents on the printer.
PIN_TTL_MIN=60
MAX_UPLOAD_MB=50
MAX_PHOTOS=36
# adapter-node refuses bodies over 512 KB by default. MUST be above MAX_UPLOAD_MB.
BODY_SIZE_LIMIT=52M
# Uploads, the job log and settings live here.
DATA_DIR=./data
# Address in the QR code on the card next to the printer.
PORTAL_URL=http://druk.lan
# Admin panel at /admin. It stays off until both are set. ADMIN_SECRET MUST be 32+ random characters:
#   openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SECRET=
# LAN address of the Ubuntu VM. docker compose binds the portal to it only.
LAN_IP=
# Port the portal listens on. Use another one when 80 is taken (e.g. by UISP).
PORTAL_PORT=80
